# Krearts Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================================================
# Required API Keys
# ============================================================================

# OpenAI API Key (for GPT-4 text generation)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Google Gemini API Key (for image generation)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...

# ============================================================================
# Optional: Model Configuration
# ============================================================================

# OpenAI Model (default: gpt-4o)
# Options: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o

# Gemini Model for image generation (default: gemini-2.5-flash-image)
GEMINI_MODEL=gemini-2.5-flash-image

# ============================================================================
# Optional: Performance Tuning
# ============================================================================

# Maximum concurrent chapter generation (default: 3)
MAX_CONCURRENT_CHAPTERS=3

# Maximum concurrent image generation (default: 3)
MAX_CONCURRENT_IMAGES=3

# ============================================================================
# Optional: Debug Settings
# ============================================================================

# Enable debug logging (default: false)
DEBUG=false

# Log level (default: INFO)
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true

# ============================================================================
# Database Config
# ============================================================================

STORYBUILDER_STORAGE_BACKEND=sqlite
STORYBUILDER_SQLITE_PATH=./cinema_server.db
CINEMA_WORKFLOW_TABLE=workflow_states
CINEMA_JOB_TABLE=jobs
# Job queue DB for legacy MovieMaker/DetectiveMaker pipelines (and any future job queue)
JOBS_SQLITE_PATH=./cinema_jobs.db
STORYBUILDER_SQLITE_TABLE=storybuilder_states

WORKFLOW_STATE_STORAGE_BACKEND=sqlite
WORKFLOW_STATE_SQLITE_PATH=./cinema_server.db
WORKFLOW_STATE_SQLITE_TABLE=workflow_states
CINEMA_WORKFLOW_TABLE=workflow_states

# Comic metadata storage
# Backend for comic chapter/page metadata: "file" (JSON only) or "sqlite" (DB-backed)
# Note: Character images are ALWAYS stored in DB (character_images table)
COMIC_METADATA_STORAGE_BACKEND=sqlite

# SQLite settings for comic metadata
COMIC_METADATA_SQLITE_PATH=./cinema_server.db
COMIC_METADATA_SQLITE_CHAPTER_TABLE=chapters
COMIC_METADATA_SQLITE_PAGE_TABLE=pages
COMIC_METADATA_SQLITE_CHARACTER_TABLE=character_images

# JSON side effects with sqlite backend: "file" to also write chapter_*.json, "none" for DB-only
# Does NOT affect character images (always in DB)
COMIC_METADATA_JSON_WRITE_MODE=file

# ============================================================================
# Asset Storage Configuration
# ============================================================================

# Base path for generated assets (images, characters, pages, etc.)
# Local: ./output (default)
# S3: s3://bucket-name or https://cdn.example.com
# This allows migration to S3/CDN without code changes
ASSET_BASE_PATH=./output

# Base URL for serving assets via HTTP (optional)
# Local dev: Leave empty, FastAPI will serve from /assets endpoint
# Production with CDN: https://cdn.example.com
# Production without CDN: https://api.example.com/assets
ASSET_BASE_URL=

# Enable FastAPI static file serving (for local dev without CDN)
# When true, mounts ASSET_BASE_PATH at /assets endpoint with cache headers
SERVE_ASSETS_LOCALLY=true

# ============================================================================
# Path Configuration
# ============================================================================

# Project root directory (for resolving knowledge files, templates, etc.)
# Docker: /app (set automatically)
# Local dev: Leave empty to auto-detect
CINEMA_ROOT=